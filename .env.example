# Application Configuration
PORT=8088
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_URL=jdbc:postgresql://localhost:5432/e_commerce_db
POSTGRES_DB=e_commerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_POOL_MAX=30
DB_POOL_MIN=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=base-notification-group
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

# JWT Configuration (Base64-encoded HS256 key, >= 256 bit)
# Generate via: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0xMjM0NTY3OA==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cookie Configuration
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# AWS S3 / RustFS Configuration
AWS_S3_ENDPOINT=https://rustfs.tuvidausotoanthu.vn
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your-s3-access-key
AWS_S3_SECRET_KEY=your-s3-secret-key
AWS_S3_BUCKET_NAME=hazi-ecommerce-media

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Giao Hàng Tiết Kiệm (GHTK) Configuration
GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=your-ghtk-api-token
GHTK_CLIENT_SOURCE=your-client-source
GHTK_TIMEOUT_MS=5000
GHTK_DEFAULT_FEE=30000
GHTK_SHOP_NAME=Hazi Store
GHTK_SHOP_TEL=0931504117
GHTK_SHOP_PROVINCE=Hà Nội
GHTK_SHOP_DISTRICT=Huyện Thanh Trì
GHTK_SHOP_WARD=Xã Thanh Liệt
GHTK_SHOP_ADDRESS=nhà số 5, ngách 21/84 Yên Xá

# SePay Payment Gateway Configuration
SEPAY_ACCOUNT_NUMBER=your-bank-account-number
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NAME=YOUR NAME
SEPAY_API_KEY=your-sepay-api-key
SEPAY_WEBHOOK_TOKEN=your-sepay-webhook-token
SEPAY_QR_TEMPLATE=compact
SEPAY_ORDER_PREFIX=ORD
