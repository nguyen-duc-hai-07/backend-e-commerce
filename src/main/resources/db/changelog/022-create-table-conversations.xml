<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="022-create-conversations" author="ecommerce">
    <createTable tableName="conversations">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_conversations_user"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <column name="status" type="VARCHAR(50)" defaultValue="OPEN">
        <constraints nullable="false"/>
      </column>

      <column name="last_message_at" type="TIMESTAMP WITH TIME ZONE"/>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <createIndex tableName="conversations" indexName="idx_conversations_user_id">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
