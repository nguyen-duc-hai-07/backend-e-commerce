<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="016-create-user-vouchers" author="ecommerce">
    <createTable tableName="user_vouchers">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="voucher_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_user_vouchers_voucher"
                     references="vouchers(id)"
                     deleteCascade="true"/>
      </column>

      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_user_vouchers_user"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <column name="order_id" type="BIGINT">
        <constraints foreignKeyName="fk_user_vouchers_order"
                     references="orders(id)"/>
      </column>

      <column name="status" type="VARCHAR(50)" defaultValue="UNUSED">
        <constraints nullable="false"/>
      </column>

      <column name="claimed_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="used_at" type="TIMESTAMP WITH TIME ZONE"/>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Unique constraint: Mỗi user chỉ claim 1 voucher cụ thể 1 lần (theo dbdiagram index) -->
    <addUniqueConstraint tableName="user_vouchers"
                         columnNames="voucher_id, user_id"
                         constraintName="uq_user_vouchers_voucher_user"/>

    <createIndex tableName="user_vouchers" indexName="idx_user_vouchers_user_id">
      <column name="user_id"/>
    </createIndex>
    <createIndex tableName="user_vouchers" indexName="idx_user_vouchers_voucher_id">
      <column name="voucher_id"/>
    </createIndex>
    <createIndex tableName="user_vouchers" indexName="idx_user_vouchers_order_id">
      <column name="order_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
