<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="021-create-notification-reads" author="ecommerce">
    <createTable tableName="notification_reads">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="notification_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_notification_reads_notification"
                     references="notifications(id)"
                     deleteCascade="true"/>
      </column>

      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_notification_reads_user"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <column name="read_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Unique constraint: Mỗi user chỉ ghi nhận đọc 1 notification 1 lần -->
    <addUniqueConstraint tableName="notification_reads"
                         columnNames="notification_id, user_id"
                         constraintName="uq_notification_reads_notification_user"/>

    <createIndex tableName="notification_reads" indexName="idx_notification_reads_user_id">
      <column name="user_id"/>
    </createIndex>
    <createIndex tableName="notification_reads" indexName="idx_notification_reads_notification_id">
      <column name="notification_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
