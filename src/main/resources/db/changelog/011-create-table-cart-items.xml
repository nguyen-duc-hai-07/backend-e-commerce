<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="011-create-cart-items" author="ecommerce">
    <createTable tableName="cart_items">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_cart_items_user"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <column name="variant_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_cart_items_variant"
                     references="product_variants(id)"
                     deleteCascade="true"/>
      </column>

      <column name="quantity" type="INT">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Quantity CHECK constraint (> 0) -->
    <sql>
      <![CDATA[
      ALTER TABLE cart_items ADD CONSTRAINT chk_cart_items_quantity CHECK (quantity > 0);
      ]]>
    </sql>

    <!-- Unique constraint: Mỗi user chỉ có 1 record cho 1 variant trong cart -->
    <addUniqueConstraint tableName="cart_items"
                         columnNames="user_id, variant_id"
                         constraintName="uq_cart_items_user_variant"/>

    <createIndex tableName="cart_items" indexName="idx_cart_items_user_id">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
