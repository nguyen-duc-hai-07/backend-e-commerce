<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="015-create-vouchers" author="ecommerce">
    <createTable tableName="vouchers">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="campaign_code" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>

      <column name="code" type="VARCHAR(50)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_vouchers_code"/>
      </column>

      <column name="discount_type" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="discount_value" type="DECIMAL(15,2)">
        <constraints nullable="false"/>
      </column>

      <column name="max_discount_amount" type="DECIMAL(15,2)"/>

      <column name="min_order_value" type="DECIMAL(15,2)" defaultValueNumeric="0.0">
        <constraints nullable="false"/>
      </column>

      <column name="max_total_claim" type="INT">
        <constraints nullable="false"/>
      </column>

      <column name="claimed_count" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="max_claim_per_user" type="INT" defaultValueNumeric="1">
        <constraints nullable="false"/>
      </column>

      <column name="claim_start_date" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="claim_end_date" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="use_start_date" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="use_end_date" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <createIndex tableName="vouchers" indexName="idx_vouchers_campaign_code">
      <column name="campaign_code"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
