<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="013-create-order-items" author="ecommerce">
    <createTable tableName="order_items">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="order_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_order_items_order"
                     references="orders(id)"
                     deleteCascade="true"/>
      </column>

      <column name="variant_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_order_items_variant"
                     references="product_variants(id)"/>
      </column>

      <column name="quantity" type="INT">
        <constraints nullable="false"/>
      </column>

      <column name="unit_price" type="DECIMAL(15,2)">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Quantity CHECK constraint (> 0) -->
    <sql>
      <![CDATA[
      ALTER TABLE order_items ADD CONSTRAINT chk_order_items_quantity CHECK (quantity > 0);
      ]]>
    </sql>

    <createIndex tableName="order_items" indexName="idx_order_items_order_id">
      <column name="order_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
