<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="034-drop-refund-account-from-return-requests" author="ecommerce">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="return_requests" columnName="refund_account"/>
    </preConditions>
    <dropColumn tableName="return_requests" columnName="refund_account"/>
  </changeSet>

</databaseChangeLog>
