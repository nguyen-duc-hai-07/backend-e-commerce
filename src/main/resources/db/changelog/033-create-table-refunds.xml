<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="033-create-table-refunds" author="ecommerce">
    <createTable tableName="refunds">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <!-- Khóa ngoại tới đơn hàng -->
      <column name="order_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_refunds_order"
                     references="orders(id)"
                     deleteCascade="true"/>
      </column>

      <!-- Khóa ngoại tới người dùng -->
      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_refunds_user"
                     references="users(id)"/>
      </column>

      <!-- Số tiền hoàn -->
      <column name="amount" type="DECIMAL(15,2)">
        <constraints nullable="false"/>
      </column>

      <!-- Thông tin tài khoản thụ hưởng -->
      <column name="account_number" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="account_holder_name" type="VARCHAR(150)">
        <constraints nullable="false"/>
      </column>

      <column name="bank_name" type="VARCHAR(150)">
        <constraints nullable="false"/>
      </column>

      <!-- Mã ngắn/Mã BIN ngân hàng để tạo link VietQR (VD: VCB, MB, TCB,...) -->
      <column name="bank_code" type="VARCHAR(20)"/>

      <!-- Link QR VietQR để Admin quét chuyển tiền -->
      <column name="qr_url" type="VARCHAR(500)"/>

      <!-- Trạng thái: PENDING, SUCCESS, FAILED -->
      <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
        <constraints nullable="false"/>
      </column>

      <!-- Lý do hoàn tiền -->
      <column name="reason" type="VARCHAR(255)"/>

      <!-- Lý do từ chối/thất bại (nếu có) -->
      <column name="reject_reason" type="VARCHAR(255)"/>

      <!-- 5 Audit Fields chuẩn theo BaseEntity -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Các index tối ưu query tra cứu -->
    <createIndex tableName="refunds" indexName="idx_refunds_order_id">
      <column name="order_id"/>
    </createIndex>
    <createIndex tableName="refunds" indexName="idx_refunds_user_id">
      <column name="user_id"/>
    </createIndex>
    <createIndex tableName="refunds" indexName="idx_refunds_status">
      <column name="status"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
