<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="018-create-return-request-images" author="ecommerce">
    <createTable tableName="return_request_images">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="return_request_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_return_request_images_request"
                     references="return_requests(id)"
                     deleteCascade="true"/>
      </column>

      <column name="image_url" type="VARCHAR(500)">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <createIndex tableName="return_request_images" indexName="idx_return_request_images_request_id">
      <column name="return_request_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
